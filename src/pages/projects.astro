---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';
---

<Layout title="Featured Projects" page="projects">

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container">
      <span class="eyebrow reveal">Portfolio</span>
      <h1 class="display-lg reveal reveal-delay-1">
        Featured <em style="color:var(--orange)">Projects</em>
      </h1>
      <p class="page-subtitle reveal reveal-delay-2">
        Real work. Real platforms. Real results — no fabricated screenshots or invented statistics.
      </p>
    </div>
    <div class="page-header-art" aria-hidden="true">
      <div class="ph-glow-orange"></div>
      <div class="ph-glow-blue"></div>
    </div>
  </section>

  <!-- NOTICE -->
  <div class="container" style="margin-top:2rem;">
    <div class="img-notice reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>Add your own screenshots and images to <code>public/images/projects/</code> to replace the placeholders below.</span>
    </div>
  </div>

  <!-- PROJECTS GALLERY — ASYMMETRIC -->
  <section class="section projects-section">
    <div class="container">

      <!-- Project 1 — Large featured -->
      <div class="project-featured reveal" id="khussa-master">
        <div class="pf-left">
          <div class="img-placeholder pf-image">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Add images to<br/><code>public/images/projects/khussa-master/</code></p>
          </div>
        </div>
        <div class="pf-right">
          <div class="project-meta-row">
            <span class="badge badge-orange">Employment</span>
            <span class="project-period-label">November 2025 – Present</span>
          </div>
          <h2 class="project-name">Khussa Master</h2>
          <p class="project-role">Social Media &amp; E-commerce Management</p>
          <p class="project-desc">
            As E-commerce Manager at Khussa Master, Ruhaba handles the full scope of day-to-day online business operations. This includes managing the existing Shopify dashboard, processing orders, maintaining product listings, communicating with customers, managing inventory, updating pricing, and providing social media posting support.
          </p>
          <p class="project-desc" style="margin-top:0.75rem;">
            She also creates AI-generated product images and coordinates with the website's developers on platform-related tasks.
          </p>
          <div class="project-note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Ruhaba operates the existing Shopify dashboard. She did not develop the website.
          </div>
          <div class="project-tags-row">
            {['Shopify Dashboard', 'E-commerce Operations', 'Product Listing', 'Customer Management', 'Inventory', 'AI Product Images', 'Social Media'].map(t => <span class="tag">{t}</span>)}
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Projects 2 & 3 — Side by side -->
      <div class="projects-pair">
        <!-- Daraz -->
        <div class="project-card-full card reveal" id="daraz">
          <div class="img-placeholder pc-image">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Add images to<br/><code>public/images/projects/daraz/</code></p>
          </div>
          <div class="pc-content">
            <div class="project-meta-row">
              <span class="badge badge-blue">Own Store</span>
              <span class="project-period-label">Oct 2022 – Present</span>
            </div>
            <h2 class="project-name">Daraz</h2>
            <p class="project-role">Independent Online Store Management</p>
            <p class="project-desc">
              Ruhaba's first independent online store, launched on Daraz in October 2022. She manages all aspects herself — product listings with SEO-friendly titles and descriptions, pricing, stock, customer communication, and order fulfilment.
            </p>
            <div class="project-tags-row">
              {['Daraz', 'Product Listing', 'SEO Content', 'Order Management', 'Customer Relations'].map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>

        <!-- Alfa Mall -->
        <div class="project-card-full card reveal reveal-delay-1" id="alfa-mall">
          <div class="img-placeholder pc-image">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Add images to<br/><code>public/images/projects/alfa-mall/</code></p>
          </div>
          <div class="pc-content">
            <div class="project-meta-row">
              <span class="badge badge-grey">Own Store</span>
              <span class="project-period-label">Post-Daraz – Present</span>
            </div>
            <h2 class="project-name">Alfa Mall</h2>
            <p class="project-role">Independent Online Store Management</p>
            <p class="project-desc">
              After her Daraz store received a good response, Alfa Mall invited Ruhaba to open an independent store on their platform. She manages product listings, pricing, stock, customer communication, and order processing.
            </p>
            <div class="project-invite-note">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Invited by Alfa Mall following strong Daraz store performance.
            </div>
            <div class="project-tags-row">
              {['Alfa Mall', 'Product Listing', 'Stock Management', 'Customer Relations'].map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      </div>

      <hr class="divider" />

      <!-- Creative Skills — 3 column -->
      <div class="creative-grid">
        <!-- AI Photography -->
        <div class="creative-card card reveal" id="ai-photography">
          <div class="img-placeholder cc-image">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <p>Add images to<br/><code>public/images/designs/</code></p>
          </div>
          <div class="cc-content">
            <span class="badge badge-orange" style="margin-bottom:0.75rem;">Skill</span>
            <h3 class="project-name">AI Product Image Creation</h3>
            <p class="project-role">AI-Generated Product Photography</p>
            <p class="project-desc">
              Using AI tools to create professional product images for e-commerce listings and social media — a modern skill that reduces photography costs and improves listing quality.
            </p>
            <div class="project-tags-row">
              {['AI Tools', 'Product Photography', 'E-commerce Images'].map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>

        <!-- Canva Design -->
        <div class="creative-card card reveal reveal-delay-1" id="canva-design">
          <div class="img-placeholder cc-image">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.477-1.142-.29-.306-.477-.704-.477-1.17 0-.924.75-1.676 1.676-1.676h1.978c3.082 0 5.576-2.494 5.576-5.576C21.922 6.182 17.418 2 12 2z"/></svg>
            <p>Add design images to<br/><code>public/images/designs/</code></p>
          </div>
          <div class="cc-content">
            <span class="badge badge-blue" style="margin-bottom:0.75rem;">Skill</span>
            <h3 class="project-name">Canva Graphic Design</h3>
            <p class="project-role">Social Media Graphics &amp; Marketing Materials</p>
            <p class="project-desc">
              Designing social media posts, promotional banners, product highlight graphics, and marketing materials using Canva — consistently on-brand and audience-ready.
            </p>
            <div class="project-tags-row">
              {['Canva', 'Social Media Graphics', 'Branding', 'Marketing'].map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>

        <!-- Video Editing -->
        <div class="creative-card card reveal reveal-delay-2" id="video-content">
          <div class="img-placeholder cc-image" style="position:relative;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
            <p>Add video thumbnails to<br/><code>public/videos/</code></p>
          </div>
          <div class="cc-content">
            <span class="badge badge-orange" style="margin-bottom:0.75rem;">Skill</span>
            <h3 class="project-name">Video Editing &amp; Content Creation</h3>
            <p class="project-role">Short-form Video &amp; Social Media Content</p>
            <p class="project-desc">
              Creating and editing short-form videos for social media — including product reels, promotional clips, and event highlights — tailored for Instagram and other platforms.
            </p>
            <div class="project-tags-row">
              {['Video Editing', 'Reels', 'Content Creation', 'Social Media'].map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
.page-header {
  position: relative;
  padding: 6rem 0 4rem;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}

.page-subtitle {
  font-size: 1.1rem;
  color: var(--grey);
  margin-top: 1rem;
  max-width: 540px;
}

.ph-glow-orange {
  position: absolute;
  width: 400px;
  height: 400px;
  background: var(--orange);
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.07;
  top: -100px;
  right: -100px;
  pointer-events: none;
}

.ph-glow-blue {
  position: absolute;
  width: 300px;
  height: 300px;
  background: var(--blue);
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.06;
  bottom: -50px;
  left: 30%;
  pointer-events: none;
}

/* Notice */
.img-notice {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.9rem 1.25rem;
  background: rgba(255, 107, 53, 0.08);
  border: 1px solid rgba(255, 107, 53, 0.2);
  border-radius: 0.5rem;
  font-size: 0.82rem;
  color: var(--grey);
}

.img-notice svg { color: var(--orange); flex-shrink: 0; }

code {
  font-family: monospace;
  font-size: 0.85em;
  background: rgba(255,255,255,0.08);
  padding: 0.1em 0.4em;
  border-radius: 3px;
  color: var(--white);
}

/* Featured project */
.project-featured {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
}

@media (min-width: 1024px) {
  .project-featured { grid-template-columns: 1fr 1fr; align-items: start; }
}

.pf-image {
  min-height: 350px;
  border-radius: 0.75rem;
}

@media (min-width: 1024px) { .pf-image { min-height: 450px; } }

.project-meta-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.project-period-label {
  font-size: 0.75rem;
  color: var(--grey);
}

.project-name {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  font-weight: 800;
  color: var(--white);
  line-height: 1.1;
  margin-bottom: 0.4rem;
}

.project-role {
  font-size: 0.9rem;
  color: var(--orange);
  font-weight: 600;
  margin-bottom: 1rem;
}

.project-desc {
  font-size: 0.875rem;
  color: var(--grey);
  line-height: 1.8;
}

.project-note {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  margin: 1.25rem 0;
  font-size: 0.75rem;
  color: var(--grey);
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  border-radius: 0.4rem;
  padding: 0.6rem 0.9rem;
}

.project-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 1.25rem;
}

/* Pair */
.projects-pair {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 768px) { .projects-pair { grid-template-columns: 1fr 1fr; } }

.project-card-full {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.pc-image {
  min-height: 220px;
  border-radius: 0.5rem 0.5rem 0 0;
}

.pc-content { padding: 1.75rem; }

.project-invite-note {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.72rem;
  color: var(--grey);
  margin: 0.75rem 0;
  background: rgba(57,123,255,0.07);
  border: 1px solid rgba(57,123,255,0.15);
  border-radius: 0.3rem;
  padding: 0.4rem 0.75rem;
}

/* Creative grid */
.creative-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 640px) { .creative-grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .creative-grid { grid-template-columns: repeat(3, 1fr); } }

.creative-card {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.cc-image {
  min-height: 200px;
  border-radius: 0.5rem 0.5rem 0 0;
}

.cc-content { padding: 1.5rem; display: flex; flex-direction: column; gap: 0; }
</style>

