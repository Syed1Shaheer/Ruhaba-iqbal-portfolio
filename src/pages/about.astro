---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me" page="about">

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container">
      <span class="eyebrow reveal">Get to Know Me</span>
      <h1 class="display-lg reveal reveal-delay-1">
        About <em style="color:var(--orange)">Ruhaba</em>
      </h1>
      <p class="page-subtitle reveal reveal-delay-2">
        A storyteller, digital strategist, and e-commerce operator based in Karachi.
      </p>
    </div>
    <div class="page-header-art" aria-hidden="true">
      <div class="ph-glow-orange"></div>
      <div class="ph-glow-blue"></div>
    </div>
  </section>

  <!-- INTRO EDITORIAL -->
  <section class="section about-intro">
    <div class="container">
      <div class="about-grid">
        <div class="about-left reveal">
          <span class="glow-line-orange" style="max-width:50px;"></span>
          <h2 class="display-sm" style="margin-bottom:1.5rem;">
            A Digital Native Building <em style="color:var(--orange)">Real-World</em> Experience
          </h2>
          <p style="color:var(--grey); line-height:1.9; margin-bottom:1.25rem;">
            Ruhaba Iqbal's journey into digital commerce began in October 2022, when she opened her own independent store on Daraz. Rather than waiting to gain experience in a classroom alone, she took the initiative to operate a live e-commerce store — learning product listing, SEO-friendly content, inventory management, and customer communication through direct, hands-on practice.
          </p>
          <p style="color:var(--grey); line-height:1.9; margin-bottom:1.25rem;">
            Her consistent performance on Daraz caught the attention of Alfa Mall, which invited her to open a store on their platform as well. Managing two independent stores while pursuing her degree, Ruhaba developed a sharp operational instinct and a practical understanding of what drives online sales.
          </p>
          <p style="color:var(--grey); line-height:1.9;">
            In November 2025, she joined Khussa Master as an E-commerce Manager, taking on responsibility for daily business operations, Shopify dashboard management, customer communication, product listings, inventory, and social media posting support.
          </p>
        </div>

        <div class="about-right">
          <!-- Education card -->
          <div class="about-card card reveal reveal-delay-1">
            <div class="about-card-header">
              <span class="eyebrow">Education</span>
              <span class="badge badge-blue">Current</span>
            </div>
            <div class="edu-detail">
              <div class="edu-degree">BS Digital Media Marketing</div>
              <div class="edu-institution">University of Karachi</div>
              <div class="edu-dept">Department of Mass Communication</div>
              <div class="edu-year">
                <span class="badge badge-orange">2nd Year — 4th Semester</span>
              </div>
            </div>
          </div>

          <!-- Languages card -->
          <div class="about-card card reveal reveal-delay-2">
            <div class="about-card-header">
              <span class="eyebrow">Languages</span>
            </div>
            <div class="lang-list">
              <div class="lang-item">
                <div class="lang-info">
                  <span class="lang-name">Urdu</span>
                  <span class="lang-level">Fluent</span>
                </div>
                <div class="lang-bar">
                  <div class="lang-fill" style="width:100%; background: var(--orange);"></div>
                </div>
              </div>
              <div class="lang-item">
                <div class="lang-info">
                  <span class="lang-name">English</span>
                  <span class="lang-level">Intermediate</span>
                </div>
                <div class="lang-bar">
                  <div class="lang-fill" style="width:65%; background: var(--blue);"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Location card -->
          <div class="about-card card reveal reveal-delay-3">
            <div class="about-card-header">
              <span class="eyebrow">Location</span>
            </div>
            <div class="loc-content">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <div style="font-weight:600; color:var(--white);">Karachi, Pakistan</div>
                <div style="font-size:0.8rem; color:var(--grey); margin-top:0.25rem;">Available for local opportunities</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section journey" style="background:var(--secondary); border-top:1px solid var(--border); border-bottom:1px solid var(--border);">
    <div class="container">
      <div class="reveal" style="margin-bottom:4rem;">
        <span class="eyebrow">Professional Journey</span>
        <h2 class="section-title">The <em style="color:var(--blue)">Story</em> So Far</h2>
      </div>

      <div class="timeline">
        <div class="timeline-track" aria-hidden="true"></div>

        <div class="timeline-item reveal">
          <div class="timeline-dot orange"></div>
          <div class="timeline-date">October 2022</div>
          <div class="timeline-content card">
            <div class="tl-badge badge badge-orange">Beginning</div>
            <h3 class="tl-title">Daraz — First Independent Store</h3>
            <p class="tl-desc">
              Launched her first independent online store on Daraz. Without any formal training, she learned product listing, SEO-friendly writing, customer communication, and order management entirely through practice.
            </p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-1">
          <div class="timeline-dot blue"></div>
          <div class="timeline-date">Post-Daraz</div>
          <div class="timeline-content card">
            <div class="tl-badge badge badge-blue">Expansion</div>
            <h3 class="tl-title">Alfa Mall — Invited to Expand</h3>
            <p class="tl-desc">
              Following a positive response on Daraz, Alfa Mall invited Ruhaba to open a store on their platform. She accepted, expanding her e-commerce presence to a second platform while continuing to manage both independently.
            </p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-2">
          <div class="timeline-dot grey"></div>
          <div class="timeline-date">2022–2025</div>
          <div class="timeline-content card">
            <div class="tl-badge badge badge-grey">Growth</div>
            <h3 class="tl-title">Skills Development</h3>
            <p class="tl-desc">
              While managing her independent stores, Ruhaba developed creative skills including Canva graphic design, video editing for social media, content creation, and AI-generated product photography.
            </p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-3">
          <div class="timeline-dot orange" style="box-shadow:0 0 15px var(--orange);"></div>
          <div class="timeline-date">November 2025</div>
          <div class="timeline-content card" style="border-color: rgba(255,107,53,0.25);">
            <div class="tl-badge badge badge-orange">Current Role</div>
            <h3 class="tl-title">E-commerce Manager — Khussa Master</h3>
            <p class="tl-desc">
              Joined Khussa Master as E-commerce Manager, taking responsibility for daily operations, Shopify dashboard management, product listings, customer communication, inventory, pricing, and social media posting support.
            </p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-4">
          <div class="timeline-dot blue" style="box-shadow:0 0 15px var(--blue);"></div>
          <div class="timeline-date">Present</div>
          <div class="timeline-content card" style="border-color: rgba(57,123,255,0.25);">
            <div class="tl-badge badge badge-blue">Education</div>
            <h3 class="tl-title">BS Digital Media Marketing — University of Karachi</h3>
            <p class="tl-desc">
              Currently in her 2nd year (4th Semester) of BS Digital Media Marketing at the Department of Mass Communication, University of Karachi — combining academic knowledge with active professional experience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PERSONAL NOTE -->
  <section class="section personal-note">
    <div class="container">
      <div class="note-layout reveal">
        <div class="note-left">
          <span class="eyebrow">Why Digital?</span>
          <span class="glow-line-orange" style="max-width:50px;"></span>
        </div>
        <div class="note-right">
          <blockquote class="note-quote">
            "I didn't just study digital marketing — I practised it. Every order processed, every product listed, and every piece of content created taught me something a textbook alone never could."
          </blockquote>
          <p style="color:var(--grey); font-size:0.9rem; margin-top:1.5rem; line-height:1.7;">
            Ruhaba brings a rare combination: academic grounding in digital media marketing, and direct hands-on e-commerce and social media management experience spanning over three years.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* Page Header */
.page-header {
  position: relative;
  padding: 6rem 0 4rem;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}

.page-subtitle {
  font-size: 1.1rem;
  color: var(--grey);
  margin-top: 1rem;
  max-width: 500px;
}

.ph-glow-orange {
  position: absolute;
  width: 400px;
  height: 400px;
  background: var(--orange);
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.07;
  top: -100px;
  right: -100px;
  pointer-events: none;
}

.ph-glow-blue {
  position: absolute;
  width: 300px;
  height: 300px;
  background: var(--blue);
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.06;
  bottom: -50px;
  left: 30%;
  pointer-events: none;
}

/* About grid */
.about-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
}

@media (min-width: 1024px) {
  .about-grid { grid-template-columns: 1.3fr 0.7fr; gap: 5rem; align-items: start; }
}

.about-right {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.about-card {
  padding: 1.5rem;
}

.about-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.edu-detail {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.edu-degree {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--white);
}

.edu-institution {
  font-weight: 600;
  color: var(--white);
  font-size: 0.9rem;
}

.edu-dept {
  font-size: 0.8rem;
  color: var(--grey);
}

.edu-year { margin-top: 0.5rem; }

.lang-list { display: flex; flex-direction: column; gap: 1rem; }

.lang-item { display: flex; flex-direction: column; gap: 0.4rem; }

.lang-info {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
}

.lang-name { color: var(--white); font-weight: 600; }
.lang-level { color: var(--grey); }

.lang-bar {
  height: 3px;
  background: rgba(255,255,255,0.08);
  border-radius: 10px;
  overflow: hidden;
}

.lang-fill {
  height: 100%;
  border-radius: 10px;
}

.loc-content {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

/* Timeline */
.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  padding-left: 2rem;
}

.timeline-track {
  position: absolute;
  left: 0;
  top: 0.6rem;
  bottom: 0.6rem;
  width: 1px;
  background: linear-gradient(to bottom, var(--orange), var(--blue), transparent);
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}

@media (min-width: 768px) {
  .timeline-item {
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    align-items: start;
  }
}

.timeline-dot {
  position: absolute;
  left: -2.35rem;
  top: 0.6rem;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--bg);
}

.timeline-dot.orange { background: var(--orange); }
.timeline-dot.blue { background: var(--blue); }
.timeline-dot.grey { background: var(--grey); }

.timeline-date {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--grey);
  letter-spacing: 0.05em;
  padding-top: 0.6rem;
}

.timeline-content {
  padding: 1.5rem;
}

.tl-badge { margin-bottom: 0.75rem; width: fit-content; }
.tl-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--white);
  margin-bottom: 0.6rem;
}
.tl-desc { font-size: 0.85rem; color: var(--grey); line-height: 1.7; }

/* Personal note */
.note-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
}

@media (min-width: 768px) {
  .note-layout { grid-template-columns: 200px 1fr; align-items: start; }
}

.note-quote {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.2rem, 2.5vw, 1.7rem);
  color: var(--white);
  line-height: 1.5;
  border-left: 3px solid var(--blue);
  padding-left: 1.5rem;
}
</style>

